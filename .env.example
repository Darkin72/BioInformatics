COMPOSE_PROJECT_NAME=bioinformatics

API_HOST_PORT=8000
FRONTEND_HOST_PORT=5173
RABBITMQ_AMQP_HOST_PORT=5672
RABBITMQ_MANAGEMENT_HOST_PORT=15672
POSTGRES_HOST_PORT=5432
CASSANDRA_HOST_PORT=9042
KAFKA_HOST_PORT=9092
SPARK_MASTER_WEB_HOST_PORT=8080
SPARK_MASTER_HOST_PORT=7077
SPARK_WORKER_WEB_HOST_PORT=8081

JWT_SECRET=dev-local-change-before-shipping
JWT_EXPIRES_SECONDS=3600
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_BASE_URL=http://localhost:8000

KAFKA_BOOTSTRAP_SERVERS=kafka:9092
RABBITMQ_DEFAULT_USER=protein
RABBITMQ_DEFAULT_PASS=protein
RABBITMQ_URL=amqp://protein:protein@rabbitmq:5672/
POSTGRES_DB=protein_metadata
POSTGRES_USER=protein
POSTGRES_PASSWORD=protein
DATABASE_URL=postgresql://protein:protein@postgres:5432/protein_metadata
CASSANDRA_HOST=cassandra
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=protein_rt
SPARK_MASTER_URL=spark://spark-master:7077

# Endpoint CAFA-6 Modal bên ngoài. Điền theo hướng dẫn trong api/README.md hoặc cafa6_modal/.env.
CAFA6_HEALTH_URL=
CAFA6_PREDICT_URL=
CAFA6_TOP_K=20
CAFA6_TIMEOUT_SECONDS=60
API_BASE_URL=http://localhost:8000
STRESS_USERNAME=operator
STRESS_PASSWORD=operator123
